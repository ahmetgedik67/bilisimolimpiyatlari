# Bilfen Algoritma Atlası — self-hosted ortam değişkenleri
# Bu dosyayı proje kökünde .env adıyla kopyalayın ve değerleri değiştirin.
# Veri tabanı PostgreSQL'dir; Supabase ücretsiz planı ile kullanabilirsiniz.

NODE_ENV=production
PORT=3000
# Supabase: Project Settings > Database > Connection string (URI)
# Pooler (pooled, 6543 portu) veya direct (5432) bağlantı kullanılabilir.
DATABASE_URL=postgresql://postgres:SIFRE_BURAYA@db.PROJE_REF.supabase.co:5432/postgres
JWT_SECRET=change-this-to-a-long-random-secret

# Yerel öğretmen/öğrenci hesapları için OAuth zorunlu değildir.
# Yönetici hesabı scripts/create-admin.ts ile oluşturulabilir.
# Manus OAuth kullanılacaksa aşağıdaki alanları doldurun:
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# İsteğe bağlı Manus depolama/harita entegrasyonları:
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
